# ================================
# SupportFlow AI - Environment Configuration
# ================================

# ─── Required API Keys ────────────────────────────────────────
# Groq API Key (for LLM inference)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Resend API Key (for sending emails)
# Get your key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here


# ─── Email Configuration ──────────────────────────────────────
# Support email address (where customers send emails)
SUPPORT_EMAIL=support@yourdomain.com

# Manager email address (receives escalation alerts)
MANAGER_EMAIL=manager@yourdomain.com

# From email address (used for sending replies via Resend)
# Note: Must be a verified domain in Resend or use onboarding@resend.dev for testing
FROM_EMAIL=onboarding@resend.dev


# ─── Gmail OAuth Configuration ────────────────────────────────
# Path to Gmail OAuth credentials file (download from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials.json

# Path to Gmail OAuth token file (auto-generated after first login)
GMAIL_TOKEN_PATH=token.json

# Email polling interval in minutes (how often to check for new emails)
EMAIL_POLL_INTERVAL_MINUTES=2


# SQLite database file path
DATABASE_PATH=supportflow.db

# Supabase PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:your_password_here@db.your_project_ref.supabase.co:6543/postgres?sslmode=require


# ─── Vector Store Configuration ───────────────────────────────
# ChromaDB persistence directory
CHROMA_DB_PATH=chroma_db

# Path to company knowledge base file
KNOWLEDGE_FILE_PATH=data/company_knowledge.txt

# HuggingFace embedding model name
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ─── LLM Configuration ────────────────────────────────────────
# Groq model to use for inference
# Options: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma-7b-it
LLM_MODEL=llama-3.3-70b-versatile

# LLM temperature (0 = deterministic, 1 = creative)
LLM_TEMPERATURE=0


# ─── Server Configuration ─────────────────────────────────────
# Server host
HOST=0.0.0.0

# Server port
PORT=8000

# Enable auto-reload on code changes (development only)
RELOAD=True

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info

# Runtime Environment (development | production)
ENVIRONMENT=development

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gmail Cloud Credentials (Optional: use in production instead of token.json file)
# GMAIL_TOKEN_JSON='{"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}'

# Security & Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_change_me
ADMIN_SESSION_SECRET=super_secret_admin_session_key_change_me

# Cookie Security Settings (auto-detected if ENVIRONMENT=production)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CORS allowed origins (comma-separated)
# Add your production Vercel frontend URL here
CORS_ORIGINS=http://localhost:3000
